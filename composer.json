{
    "name": "robinsonryan/dibs",
    "description": "Headless slot-based booking engine for Laravel: availabilities generate slots, offers hold them, bookings claim them; polymorphic hosts with roles. No UI, no auth, no notifications - fires events, consumers decide.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Robinson"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RobinsonRyan\\Dibs\\": "src/",
            "RobinsonRyan\\Dibs\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobinsonRyan\\Dibs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobinsonRyan\\Dibs\\DibsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyze": "phpstan analyse",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "quality": [
            "@lint:check",
            "@analyze",
            "@refactor:check",
            "@test"
        ]
    }
}
